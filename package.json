{
  "name": "kung-food-pandas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @repo/api... build",
    "build:web": "pnpm --filter @repo/web... build",
    "start:api": "pnpm --filter @repo/api start",
    "preview:web": "pnpm --filter @repo/web preview",
    "storybook:web": "pnpm --filter @repo/web storybook",
    "build-storybook:web": "pnpm --filter @repo/web build-storybook",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/api db:migrate:deploy",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "docs:generate": "pnpm --filter @repo/api docs:generate",
    "docs:lint": "pnpm --filter @repo/api docs:lint",
    "docs:bundle": "pnpm --filter @repo/api docs:bundle",
    "docs:build": "pnpm --filter @repo/api docs:build",
    "docs:preview": "pnpm --filter @repo/api docs:preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
