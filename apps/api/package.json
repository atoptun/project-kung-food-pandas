{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm db:generate && pnpm docs:generate && tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "docs:generate": "tsx src/docs/generate-openapi.ts",
    "docs:lint": "pnpm docs:generate && redocly lint openapi.yaml",
    "docs:bundle": "pnpm docs:generate && redocly bundle openapi.yaml -o openapi.bundled.yaml",
    "docs:build": "pnpm docs:generate && redocly build-docs openapi.yaml -o docs-dist/index.html",
    "docs:preview": "pnpm docs:generate && redocly preview-docs openapi.yaml"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@better-auth/prisma-adapter": "^1.7.19",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.7.19",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.77.0",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
