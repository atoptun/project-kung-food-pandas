# ==============================================================================
# ENVIRONMENT TEMPLATE
# Copy this file to `.env.local` for local development.
# In production, configure these variables in Render (Backend) and Vercel (Frontend).
# ==============================================================================

# --- Runtime & Server (Backend: Render) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed origins (include Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL Database (Local Docker / Production: Neon.tech) ---
# Neon.tech uses PgBouncer connection pooling.
# DATABASE_URL: Use the pooled connection string (`-pooler` hostname + `?pgbouncer=true`) in production.
# DIRECT_URL: Use the direct connection string (without `-pooler`) required by Prisma CLI for migrations.
DATABASE_URL="postgresql://kfp:kfp_local_pass@localhost:5432/kfp_db?schema=public"
DIRECT_URL="postgresql://kfp:kfp_local_pass@localhost:5432/kfp_db?schema=public"

# --- Cloudinary Media Storage (Backend) ---
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# --- Frontend (Vercel) ---
# Base URL of the backend API (e.g. https://kung-food-pandas-api.onrender.com in production)
VITE_API_URL=http://localhost:4000
